# Copy to .env (this folder) or ~/.config/foremankit/.env. Never commit real keys.
# A provider is active only when its key is set.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# Local / remote LLM servers: llama.cpp llama-server is the primary one (llama/start-llama.ps1); Ollama is an optional
# fallback tried second. Providers: llm_local / llm_remote (formerly ollama_local / ollama_remote: the old names and the
# OLLAMA_REMOTE_LAN_URL variables keep working).
LLAMACPP_URL=http://127.0.0.1:8080
#OLLAMA_LOCAL_URL=http://localhost:11434      # only if you really run Ollama (this is the default when unset)
# Remote machine: LAN address
LLM_REMOTE_LAN_URL=
# Optional on/off/auto overrides for the local / remote LLM (CLI `foremankit llm ...` wins over these)
#LLM_LOCAL_ENABLED=auto
#LLM_REMOTE_ENABLED=auto

# Per-machine speed of the local LLM, used by the router's time estimate (default: providers.yaml `speed`, measured on
# the ZBook). Take tg_tok_s / pp_tok_s of this machine from llama/profiles.json (a bit lower is safer).
#LOCAL_LLM_GEN_TPS=30
#LOCAL_LLM_PROMPT_TPS=220

# Per-machine opt-in: providers that may receive sensitivity="internal" (process data) ON THIS MACHINE, besides
# those marked allow_internal in providers.yaml. Providers with trains_on_data=true are still refused.
# Only for providers whose policy forbids training on prompts (DeepSeek's does not: use the variable below).
#FOREMANKIT_ALLOW_INTERNAL=deepseek

# Deliberate per-machine acceptance: these providers get sensitivity="internal" data even though they may train on
# prompts (DeepSeek: policy allows training, data stored in China; checked 2026-10-08). Never for "private".
#FOREMANKIT_ALLOW_INTERNAL_TRAINING=deepseek

# Testing: 1 = fake responses, no network calls to providers
#FOREMANKIT_DRY_RUN=1

# Two laptops lending their local LLM server to each other (config/peers.yaml): shared key, same value on both machines.
# Create it with `foremankit peers key`; FOREMANKIT_SELF forces which peers.yaml entry is this machine; FOREMANKIT_PEER_<NAME>_LAN
# overrides a peer's LAN address list (e.g. a fixed DHCP lease).
FOREMANKIT_PEER_KEY=
#FOREMANKIT_SELF=
#FOREMANKIT_PEER_LEGION_LAN=
